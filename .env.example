###> Docker Image (automatiquement défini par CD en production) ###
# IMAGE_REF est automatiquement mis à jour par le workflow CD lors du déploiement
# Pour dev local: laisser vide ou utiliser une image buildée localement
# IMAGE_REF=ghcr.io/c-fevre/homey-enedis-proxy:latest
###< Docker Image ###

###> Application ###
BASE_URL=https://example.com/appli
REDIRECT_URI=https://example.com/appli/Auth
LIMIT_REQUESTS_PER_MINUTE=12
#VERSION_MIN=
###< Application ###

###> Enedis OAuth Endpoints (NE PAS MODIFIER EN PRODUCTION) ###
# v2 depuis la bascule Enedis du 28/09/2026 (l'ancienne URL /v1/ ne doit plus être utilisée)
AUTHORIZATION_ENDPOINT=https://mon-compte-particulier.enedis.fr/dataconnect/v2/oauth2/authorize
TOKEN_ENDPOINT=https://gw.ext.prod.api.enedis.fr/oauth2/v3/token
DATA_ENDPOINT=https://gw.ext.prod.api.enedis.fr
###< Enedis OAuth Endpoints ###

###> Nouvelles API Enedis (bascule du 28/09/2026) ###
# auto   : nouvelles API d'abord, repli sur les anciennes API v5 en cas d'échec (transition)
# new    : nouvelles API uniquement (à activer une fois les API v5 arrêtées)
# legacy : anciennes API v5 uniquement
ENEDIS_API_MODE=auto
#SUBSCRIBED_SERVICES_PATH=subscribed_services/v1
#LOAD_CURVE_TIMESTAMP=auto
#CONTRACT_DEGRADED_FALLBACK=1
###< Nouvelles API Enedis ###

###> Enedis Credentials (À OBTENIR SUR https://datahub-enedis.fr) ###
# EXTERNAL_CLIENT_ID : Clé publique utilisée par les applications externes (Homey, etc.)
# Générer avec: openssl rand -hex 20 | sed 's/^/hmey_prod_/'
EXTERNAL_CLIENT_ID=FILLME
# CLIENT_ID/SECRET : Identifiants Enedis Data Hub (privés, ne jamais exposer)
CLIENT_ID=clientid
CLIENT_SECRET=clientsecret
# Durée du consentement, en JOURS. Ne pas utiliser d'années pleines (P3Y, P2Y, P1Y) :
# le portail Enedis les rejette (contrôle sur moment.duration().months()/.days(), tous
# deux nuls pour une année pleine) et affiche « Une erreur est survenue ».
# P1095D = 3 ans, le maximum autorisé par Enedis.
DURATION=P1095D
###< Enedis Credentials ###

###> Optional Features - SÉCURITÉ ###
# PKCE (Proof Key for Code Exchange) - RFC 7636
# NON SUPPORTÉ PAR ENEDIS - Laisser à 0
PKCE=0
# Type de flux
# Enedis: consentement + retour usage_point_id (pas d'authorization_code)
# Mettre une valeur différente de DEVICE pour ne pas échanger le code
FLOW=CONSENT
# Désactiver auth sur data endpoint (déconseillé en prod)
#DISABLE_DATA_ENPOINT_AUTH=true
###< Optional Features ###

###> Database (PostgreSQL) ###
DB_ADDRESS=db.example.com
DB_PORT=5432
DB_USER=dbuser
DB_PASSWORD=passwordexample1234
DB_NAME=db_base
# DB_TYPE="mongodb"  # Si besoin MongoDB au lieu de PostgreSQL
###< Database ###

#Postgresql if unset
#DB_TYPE="mongodb"

#TRUSTED_PROXIES=
##Examples
##TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=1234567891234567894f16123
###< symfony/framework-bundle ###
