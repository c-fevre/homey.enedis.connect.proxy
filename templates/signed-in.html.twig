{# templates/index.html.twig #}
{% extends 'layout.html.twig' %}

{% block title %}Consentement obtenu{% endblock %}

{% block content %}
<h2>✅ Consentement obtenu !</h2>
<p>Le consentement a bien été enregistré pour <strong>Mon Suivi Conso Enedis</strong> sur votre Homey Pro.</p>
<p>Vous pouvez fermer cette page et retourner sur Homey.</p>

<script>
// Enedis peut charger cette page dans son iframe de consentement : on remonte au
// niveau supérieur pour que l'utilisateur voie bien la confirmation en pleine page.
if (window.top !== window.self) {
  window.top.location.href = window.location.href;
}
window.history.replaceState({}, '', "{{ url('device') }}");
</script>
{% endblock %}
